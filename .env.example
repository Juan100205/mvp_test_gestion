# Copia este archivo como .env y cambia los valores.
DB_CLAVE=cambia-esta-clave
# Mínimo 32 caracteres. Genera una con: openssl rand -base64 48
JWT_CLAVE=
PUERTO_WEB=8080
# Development expone /openapi/v1.json; usa Production fuera de la demo.
AMBIENTE=Development
# true carga estrategias y acompañamientos de ejemplo (solo si la base está vacía).
DATOS_DEMO=true
